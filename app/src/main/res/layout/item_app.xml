<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal" android:padding="8dp">
    <ImageView android:id="@+id/icon" android:layout_width="54dp" android:layout_height="54dp"/>
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="12sp"
        android:singleLine="true" android:ellipsize="end" android:maxWidth="76dp"
        android:shadowColor="#90000000" android:shadowDy="1" android:shadowRadius="3"/>
</LinearLayout>
